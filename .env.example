APP_ENV=development
DATABASE_URL=mysql+aiomysql://agent:agent@mysql:3306/agent_token
REDIS_URL=redis://redis:6379/0
MEMCACHED_ENABLED=true
MEMCACHED_HOST=memcached
MEMCACHED_PORT=11211
ADMIN_KEY=change-me

# Direction A: delayed cancellation queue (timeout release)
ORDER_FULFILLMENT_TIMEOUT_SECONDS=900
DELAY_CANCEL_BATCH_SIZE=50
DELAY_CANCEL_SCAN_INTERVAL_SECONDS=5
DELAY_CANCEL_ENABLED=true

# Direction B: multi-dimensional rate limit + challenge gate
RATE_LIMIT_ENABLED=true
RATE_LIMIT_USER_LIMIT=10
RATE_LIMIT_USER_WINDOW=60
RATE_LIMIT_IP_LIMIT=30
RATE_LIMIT_IP_WINDOW=60
RATE_LIMIT_ACTIVITY_LIMIT=100
RATE_LIMIT_ACTIVITY_WINDOW=60
CHALLENGE_ENABLED=false
CHALLENGE_TTL_SECONDS=120

# Direction C: realtime stock push (SSE)
STOCK_CHANNEL_PREFIX=token:stock
STOCK_SSE_HEARTBEAT_SECONDS=15

LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
